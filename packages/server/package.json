{
  "name": "@squadboard/server",
  "version": "0.0.0",
  "private": true,
  "description": "Local Fastify server for Squadboard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node bin/squadboard.js",
    "typecheck": "pnpm --filter @squadboard/core build && tsc --noEmit",
    "test": "pnpm --filter @squadboard/core build && vitest run",
    "db:generate": "drizzle-kit generate",
    "try": "pnpm --filter @squadboard/core build && tsx scripts/try-runner.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@squadboard/core": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.2.1",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "files": [
    "bin",
    "dist",
    "drizzle"
  ],
  "bin": {
    "squadboard": "./bin/squadboard.js"
  }
}
